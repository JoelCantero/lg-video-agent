{
  "name": "lg-video-agent",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "remotion preview src/index.tsx",
    "render": "remotion render src/index.tsx EsglesiaLaGarriga out/esglesia-la-garriga.mp4",
    "build": "tsc --noEmit",
    "resources:deploy": "vite --config resources/vite.config.ts --host 127.0.0.1",
    "resources:build": "tsc --noEmit -p resources/tsconfig.json && vite build --config resources/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/player": "4.0.532",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "parse5": "^8.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.1"
  }
}
